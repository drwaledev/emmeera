<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/all_bg"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin">

    <!-- Previous layout components remain the same until the OtpView -->

    <com.mukesh.OtpView
        android:id="@+id/pin_entry_simple"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="16sp"
        app:digitBackground="@android:color/white"
        app:digitElevation="2dp"
        app:digitLength="4"
        app:digitSpacing="8dp"
        app:digitWidth="24dp"
        app:lineColor="@color/black"
        app:lineWidth="2dp"
        app:otp="1234" />

    <com.mukesh.OtpView
        android:id="@+id/pin_entry_confirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="16sp"
        app:digitBackground="@android:color/white"
        app:digitElevation="2dp"
        app:digitLength="4"
        app:digitSpacing="8dp"
        app:digitWidth="24dp"
        app:lineColor="@color/black"
        app:lineWidth="2dp"
        app:otp="1234" />

    <!-- Rest of the layout remains the same -->
</RelativeLayout>