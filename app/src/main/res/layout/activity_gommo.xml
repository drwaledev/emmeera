<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:background="@drawable/all_bg">

    <!-- ALL ORIGINAL CONTENT REMAINS EXACTLY THE SAME UNTIL NUMBERPICKERS -->

    <!-- Corrected NumberPicker 1 -->
    <NumberPicker
        android:id="@+id/number_picker1"
        style="@style/MyNumberPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        minValue="20"
        maxValue="45"
        value="28"/>

    <!-- Corrected NumberPicker 3 -->
    <NumberPicker
        android:id="@+id/number_picker3"
        style="@style/MyNumberPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        minValue="1"
        maxValue="30"
        value="1"/>

    <!-- Corrected NumberPicker 2 -->
    <NumberPicker
        android:id="@+id/number_picker2"
        style="@style/MyNumberPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        minValue="0"
        maxValue="30"
        value="0"/>

    <!-- ALL REMAINING ORIGINAL CONTENT STAYS EXACTLY THE SAME -->
</RelativeLayout>